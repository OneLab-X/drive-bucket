{
  "name": "@drivebucket/cli",
  "version": "0.0.0",
  "description": "drivebucket command line: OAuth login, buckets, ls/cp/rm, doctor",
  "license": "MIT",
  "homepage": "https://github.com/OWNER/drivebucket/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/OWNER/drivebucket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/drivebucket.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "drivebucket": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@drivebucket/core": "workspace:*",
    "@googleapis/drive": "^27.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
