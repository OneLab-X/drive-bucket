# Integration tests (DRIVEBUCKET_IT=1 pnpm test:it)
DRIVEBUCKET_IT=0
DRIVEBUCKET_CLIENT_ID=
DRIVEBUCKET_CLIENT_SECRET=
DRIVEBUCKET_REFRESH_TOKEN=
# Optional: use an existing root folder (needs `drive` scope unless the app created it)
DRIVEBUCKET_ROOT_FOLDER_ID=

# Server (drivebucket-server / Docker). Pick OAuth (above) or a service account:
# DRIVEBUCKET_SA_KEY_FILE=/run/secrets/sa.json
# DRIVEBUCKET_SA_SUBJECT=user@yourdomain.com
# DRIVEBUCKET_SHARED_DRIVE_ID=
DRIVEBUCKET_PUBLIC_BUCKETS=photos
DRIVEBUCKET_CACHE_CONTROL=public, max-age=86400
DRIVEBUCKET_RESIZE_WIDTHS=320,640,1280,1920
# DRIVEBUCKET_REDIS_URL=redis://localhost:6379
# DRIVEBUCKET_TRUST_PROXY=true
# S3 API (omit to run the read proxy only)
# DRIVEBUCKET_S3_ACCESS_KEY_ID=
# DRIVEBUCKET_S3_SECRET_ACCESS_KEY=   # 40 random chars: openssl rand -base64 30
# DRIVEBUCKET_CORS_ORIGINS=https://app.example.com
PORT=8080
