# npx @drivebucket/cli auth login --client-id … --client-secret … >> .env.local
DRIVEBUCKET_CLIENT_ID=
DRIVEBUCKET_CLIENT_SECRET=
DRIVEBUCKET_REFRESH_TOKEN=
BUCKET=photos

# Optional: drivebucket-server (behind a CDN) with DRIVEBUCKET_PUBLIC_BUCKETS=photos.
# When set, the gallery renders resized variants from it (?w=…&format=webp) instead of this app's route.
NEXT_PUBLIC_DRIVEBUCKET_PROXY_URL=

# Uploads are open in development. In production set this (and replace auth() in route.ts with your real session check).
UPLOAD_TOKEN=
